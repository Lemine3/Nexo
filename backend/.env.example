# ── Meshily Backend — environment configuration ──────────────
NODE_ENV=development
PORT=4000

# PostgreSQL & Redis
DATABASE_URL=postgresql://meshily:meshily@localhost:5432/meshily
REDIS_URL=redis://localhost:6379

# JWT — generate long random strings for production:
#   openssl rand -hex 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=30

# OTP: in dev mode the code is returned by the API (no SMS gateway needed).
# Set to false in production and wire the SMS gateway in src/utils/otp.ts.
OTP_DEV_MODE=true
OTP_TTL_MINUTES=5

# Dispatch tuning
DISPATCH_RADIUS_KM=7
DISPATCH_MAX_DRIVERS=8
DISPATCH_ACCEPT_TIMEOUT_SEC=25

# Firebase Cloud Messaging (optional in dev; push logs to console if unset)
# FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json

# Payments — filled after signing merchant agreements
# BANKILY_API_URL=
# BANKILY_MERCHANT_ID=
# BANKILY_API_KEY=
# MASRIVI_API_URL=
# MASRIVI_MERCHANT_ID=
# MASRIVI_API_KEY=

# CORS (comma-separated origins; * for dev)
CORS_ORIGINS=*

# ── First super admin (used ONCE by `npm run seed`) ──────────
# ⚠️ Set these privately on the server. Never commit real values.
# SUPER_ADMIN_PHONE=+222XXXXXXXX
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=
